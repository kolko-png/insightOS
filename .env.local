# ---------- Snowflake connection (SDK — SQL queries) ----------
# Account identifier, e.g. "xy12345.us-east-1" — Admin → Accounts.
SNOWFLAKE_ACCOUNT=BGREAFR-IK87096.snowflakecomputing.com
# The user INSIGHTOS_APP_RUNTIME authenticates as (see
# snowflake/ddl/02_provisioning.sql for the role this user should
# default into).
SNOWFLAKE_APP_RUNTIME_USER=INSIGHTOS_APP_RUNTIME_USER
# Key-pair auth for the SDK connection (lib/snowflake/client.ts,
# admin.ts) — path to a PEM private key file, NOT the key contents
# inline. On Vercel: write the key to a file at build/runtime via a
# build step, or use Vercel's file-based secret mounting — do not
# commit this file.
SNOWFLAKE_PRIVATE_KEY_PATH=/Users/blue/keys/insightos/snowflake_rsa_key.p8

# ---------- Snowflake Cortex REST auth ----------
# Primary path (Phase 8 decision): a Programmatic Access Token,
# generated in Snowsight under Profile → Programmatic Access Tokens.
# Simpler than key-pair JWT for a hackathon timeline, at the cost of
# needing rotation before it expires (15-day default).
SNOWFLAKE_PAT=
# If SNOWFLAKE_PAT is unset, lib/snowflake/auth.ts falls back to
# signing a key-pair JWT using SNOWFLAKE_PRIVATE_KEY_PATH above —
# no separate env var needed for that path.

# Model used for Cortex COMPLETE / chat streaming. Defaults to
# llama3.1-70b in code if unset — override if your account's region
# doesn't have that model enabled (`SHOW MODELS IN SNOWFLAKE.CORTEX`).
SNOWFLAKE_CORTEX_MODEL=llama3.1-70b

# ---------- Email (automation "send_email" action) ----------
# Optional — without it, lib/email/resend.ts logs instead of
# sending (Phase 10 soft-fail), so automation runs still complete.
RESEND_API_KEY=
RESEND_FROM_EMAIL="InsightOS <notifications@yourdomain.com>"

# ---------- Automation cron ----------
# Any random secret string. Vercel Cron sends this as
# `Authorization: Bearer <value>` on scheduled invocations of
# /api/cron/automation — set the same value here and in Vercel's
# environment variables so the route can verify the request is
# actually from Vercel Cron and not a public, guessable URL.
CRON_SECRET=

# ---------- App ----------
# Used to build OAuth/password-reset redirect URLs
# (lib/services/auth.service.ts). Must match your deployed domain
# exactly (including https://, no trailing slash) — a mismatch here
# is the most common cause of "OAuth redirect_uri mismatch" errors.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
